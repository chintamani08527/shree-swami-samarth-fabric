{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/(Shree-Swami-Samarth-Fabric\\.apk|app-debug\\.apk|download|download-app)",
      "destination": "https://github.com/chintamani08527/shree-swami-samarth-fabric/releases/download/v1.1.0/Shree-Swami-Samarth-Fabric.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Shree-Swami-Samarth-Fabric.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!.*\\.(?:apk|png|jpg|jpeg|svg|css|js|ico|json|woff2?|xlsx)).*)",
      "destination": "/index.html"
    }
  ]
}
