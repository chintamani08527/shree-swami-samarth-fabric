// Prisma Schema for Shree Swami Samarth Fabric Attendance Management System (SQLite Local Development / Testing)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  workerId     String    @unique // e.g. SSF-001, ADM-001, SUP-001
  name         String
  phone        String?
  passwordHash String
  role                String    @default("WORKER") // ADMIN, SUPERVISOR, WORKER
  wageType            String    @default("FIXED")  // FIXED or CUSTOM
  dailyWage           Float?    // Fixed Daily wage or pay rate (₹)
  customWageRate      Float?    // Custom Wage Rate for 1 machine per 1 hour (₹)
  hasCustomWageAccess Boolean   @default(false)    // Custom wage entry access granted by admin
  isActive     Boolean   @default(true)
  joiningDate  DateTime  @default(now())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  attendanceRecords AttendanceRecord[]
  workerShifts      WorkerShift[]
  auditLogs         AuditLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workerId])
  @@index([role])
  @@index([departmentId])
  @@index([isActive])
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. Weaving, Jacquard, Spinning, Dyeing
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model AttendanceRecord {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId          String
  attendanceDate    String    // YYYY-MM-DD format (Asia/Kolkata date)
  checkInAt         DateTime? // UTC timestamp
  checkOutAt        DateTime? // UTC timestamp
  shiftType         String?   @default("DAY") // DAY or NIGHT (worker selected)
  status            String    @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT, ON_LEAVE, HOLIDAY
  source            String    @default("WEB_MOBILE") // WEB_MOBILE, WEB_DESKTOP, MANUAL_CORRECTION, ADMIN_OVERRIDE
  workingMinutes    Int       @default(0) // actual working minutes excluding break
  breakMinutes      Int       @default(0) // deducted break minutes
  overtimeMinutes   Int       @default(0) // overtime minutes beyond shift
  lateMinutes       Int       @default(0) // late arrival minutes beyond grace period
  machinesOperated  Int?      // Custom wages: count of machines operated
  hoursOperated     Float?    // Custom wages: total hours machines operated
  isMissingCheckOut Boolean   @default(false)
  remarks           String?   // Notes, correction reasons, etc.

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, attendanceDate])
  @@index([attendanceDate])
  @@index([workerId])
  @@index([status])
  @@index([isMissingCheckOut])
}

model Shift {
  id                    String        @id @default(uuid())
  name                  String        @unique // e.g. General Shift (8 AM - 5 PM)
  startTime             String        // HH:mm (e.g. 08:00)
  endTime               String        // HH:mm (e.g. 17:00)
  gracePeriodMinutes    Int           @default(15)
  breakDurationMinutes  Int           @default(60)
  halfDayThresholdHours Float         @default(4.0)
  fullDayThresholdHours Float         @default(8.0)
  isActive              Boolean       @default(true)
  workerShifts          WorkerShift[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model WorkerShift {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([shiftId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName   String?
  action      String   // e.g. CORRECTION, WORKER_CREATED, PIN_RESET
  entityType  String   // ATTENDANCE, WORKER, DEPARTMENT, SETTINGS
  entityId    String?
  reason      String
  details     String?  // JSON string
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model CompanySettings {
  id                   String   @id @default("default-settings")
  companyName          String   @default("Shree Swami Samarth Fabric")
  timezone             String   @default("Asia/Kolkata")
  defaultWorkingHours  Float    @default(8.0)
  attendanceRules      String   // JSON string of rules
  updatedAt            DateTime @updatedAt
}
