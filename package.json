{
  "name": "shree-swami-samarth-fabric",
  "version": "1.0.0",
  "description": "Smart Attendance Management System for Shree Swami Samarth Fabric",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "vercel-build": "npm --prefix server run prisma:generate && npm --prefix server run build && npm --prefix client run build",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg-gateway": "^0.3.0-beta.4",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "attendance",
    "textile",
    "manufacturing",
    "react",
    "express",
    "prisma",
    "sqlite",
    "exceljs"
  ],
  "author": "Shree Swami Samarth Fabric",
  "license": "UNLICENSED"
}
